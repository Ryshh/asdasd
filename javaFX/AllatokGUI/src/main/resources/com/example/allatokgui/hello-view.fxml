<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.input.*?>
<?import javafx.scene.layout.*?>


<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.allatokgui.HelloController">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="Fájl">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#Megnyitas" text="Megnyitás">
                     <accelerator>
                        <KeyCodeCombination alt="UP" code="O" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                     </accelerator>
                  </MenuItem>
                  <MenuItem mnemonicParsing="false" onAction="#Kilepes" text="Kilépés">
                     <accelerator>
                        <KeyCodeCombination alt="UP" code="Q" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                     </accelerator>
                  </MenuItem>
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Sugó">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#Nevjegy" text="Névjegy" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <HBox maxHeight="1.7976931348623157E308" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <ListView fx:id="lista" maxWidth="1.7976931348623157E308" prefHeight="300.0" prefWidth="250.0" HBox.hgrow="ALWAYS" />
            <VBox spacing="10.0">
               <children>
                  <Label text="Mettől (cm):" />
                  <TextField fx:id="tfMettol" text="0" />
                  <Label layoutX="10.0" layoutY="10.0" text="Meddig (cm):" />
                  <TextField fx:id="tfMeddig" layoutX="10.0" layoutY="27.0" text="1000" />
                  <Button fx:id="btSzures" disable="true" mnemonicParsing="false" onAction="#Szures" text="Szűrés" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </children>
</VBox>
